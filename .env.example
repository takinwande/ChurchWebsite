# ─────────────────────────────────────────────────────────────
# Public — safe to expose to the browser
# ─────────────────────────────────────────────────────────────

# Sanity CMS — required
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Site URL — used for sitemap + OpenGraph metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.com


# ─────────────────────────────────────────────────────────────
# Server-only — never exposed to the browser.
# These must ALSO be set in the Vercel dashboard (Settings →
# Environment Variables). A local .env.local alone is not enough:
# without them in Vercel the contact and prayer forms return 500
# in production.
# ─────────────────────────────────────────────────────────────

# Sanity write token — REQUIRED for the contact and prayer forms.
# Both routes persist the submission to Sanity before emailing, so
# without this every submission fails with a 500.
# Create at sanity.io/manage → API → Tokens (Editor permission).
SANITY_API_WRITE_TOKEN=

# Sanity read token — optional (only needed for draft/preview mode)
SANITY_API_READ_TOKEN=

# Resend API key — required to send form notifications.
# If missing, submissions are still stored in Sanity and the failure
# is logged, but no notification email goes out.
RESEND_API_KEY=

# Verified sender address — required for notifications to actually
# arrive. Without it, mail is sent from onboarding@resend.dev, which
# is Resend's shared test sender and ONLY delivers to the Resend
# account owner's own address; every other recipient is rejected.
# Verify a domain at resend.com/domains, then use an address on it.
RESEND_FROM_EMAIL=noreply@your-domain.com
